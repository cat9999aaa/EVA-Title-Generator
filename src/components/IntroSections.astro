---
import { formatOptions } from '@/lib/config/formats'
import type { Dictionary } from '@/lib/i18n/types'
const { dict } = Astro.props as { dict: Dictionary }
const sections = [
 [dict.sections.useCasesTitle, dict.sections.useCasesIntro, dict.sections.useCases],
 [dict.sections.workflowTitle, dict.sections.workflowIntro, dict.sections.workflow],
 [dict.sections.technicalTitle, dict.sections.technicalIntro, dict.sections.technical],
] as const
---
<section class="dv-info-section"><header class="dv-archive-head"><p>OUTPUT ／ FORMATS</p><h2>{dict.sections.formatsTitle}</h2><span>{dict.sections.formatsIntro}</span></header><div class="dv-format-grid">{formatOptions.map((format,index)=><article class="dv-record"><b>{String(index+1).padStart(2,'0')}</b><div><h3>{dict.generator.formatCopy[format.id].label}</h3><p>{dict.generator.formatCopy[format.id].hint}</p></div><strong>{format.ratio}<br/>{format.width}×{format.height}</strong></article>)}</div></section>
{sections.map(([title,intro,items],sectionIndex)=><section class="dv-info-section"><header class="dv-archive-head"><p>{String(sectionIndex+1).padStart(2,'0')} ／ DASHEN TITLE</p><h2>{title}</h2><span>{intro}</span></header><div class="dv-grid">{items.map((item,index)=><article class="dv-info-record"><b>{String(index+1).padStart(2,'0')}</b><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>)}
