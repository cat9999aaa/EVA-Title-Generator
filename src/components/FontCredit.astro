---
import type { Dictionary } from '@/lib/i18n/types'
const { dict } = Astro.props as { dict: Dictionary }
---
<section class="dv-info-section"><header class="dv-archive-head"><p>FONT ／ CREDIT</p><h2>{dict.credit.title}</h2></header><div class="dv-alert"><strong>LICENSE / FONT</strong><p>{dict.credit.body}</p><p>{dict.credit.note}</p><a class="dv-text-link" href={dict.credit.upstreamUrl} target="_blank" rel="noreferrer">{dict.credit.upstreamLabel}</a></div></section>
