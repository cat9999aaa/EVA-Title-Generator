---
import LanguageSwitcher from '@/components/LanguageSwitcher.astro'
import { pageHref, type SitePage } from '@/lib/i18n/locales'
import type { Dictionary } from '@/lib/i18n/types'
const { dict, page = 'home' } = Astro.props as { dict: Dictionary; page?: SitePage }
const links = [
  [pageHref(dict.locale, 'home'), dict.nav.generator],
  [pageHref(dict.locale, 'about'), dict.nav.about],
  [pageHref(dict.locale, 'faq'), dict.nav.faq],
  [pageHref(dict.locale, 'apiDocs'), dict.nav.apiDocs],
]
---
<header class="dv-header">
  <a class="dv-header__logo" href={pageHref(dict.locale, 'home')} aria-label={dict.nav.homeAria}>大神标题<small>{dict.chrome.brandSmall}</small></a>
  <button class="dv-header__menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-toggle>{dict.nav.menu}</button>
  <nav id="primary-nav" aria-label={dict.nav.primaryNav} data-primary-nav>
    {links.map(([href,label]) => <a href={href} aria-current={dict.pagePath === href ? 'page' : undefined}>{label}</a>)}
  </nav>
  <div class="dv-header__actions">
    <LanguageSwitcher dict={dict} page={page} />
    <a class="dv-header__business" href="https://dashen.wang/" rel="home">DASHEN.WANG</a>
  </div>
</header>
<script is:inline>
  document.querySelectorAll('[data-menu-toggle]').forEach((button)=>button.addEventListener('click',()=>{
    const nav=document.querySelector('[data-primary-nav]');const open=nav?.getAttribute('data-open')==='true';nav?.setAttribute('data-open',String(!open));button.setAttribute('aria-expanded',String(!open));
  }))
</script>
