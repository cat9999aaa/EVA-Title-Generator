---
import { LOCALE_META, SITE_LOCALES, SITE_ORIGIN, pageHref, type SitePage } from '@/lib/i18n/locales'
import type { Dictionary } from '@/lib/i18n/types'

const { dict } = Astro.props as { dict: Dictionary }

const site = Astro.site ?? new URL(SITE_ORIGIN)
const canonicalUrl = new URL(dict.pagePath, site).toString()
const imageUrl = new URL('/og/eva-title-generator.svg', site).toString()
const meta = LOCALE_META[dict.locale]
const currentPage: SitePage = dict.pagePath.endsWith('/api-docs')
  ? 'apiDocs'
  : dict.pagePath.endsWith('/about')
    ? 'about'
    : dict.pagePath.endsWith('/faq')
      ? 'faq'
      : 'home'
const alternates = [
  ...SITE_LOCALES.map((locale) => ({
    hrefLang: LOCALE_META[locale].hrefLang,
    href: new URL(pageHref(locale, currentPage), site).toString(),
  })),
  { hrefLang: 'x-default', href: new URL(pageHref('zh-CN', currentPage), site).toString() },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: dict.locale,
  mainEntity: dict.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
}

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'EVA标题生成器',
  alternateName: 'EVA Title Generator',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Web Browser',
  browserRequirements: 'Requires JavaScript and a modern browser.',
  inLanguage: SITE_LOCALES,
  description: dict.pageDescription,
  url: canonicalUrl,
  image: imageUrl,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  featureList: [
    'Centered EVA-style title layout',
    'PNG and WebP export',
    'SVG export',
    'Five-language interface',
    'Article, square, promo, and social cover sizes',
  ],
  isBasedOn: 'https://github.com/kaonashi-tyc/Eva-Ming-Simplified',
}

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'EVA标题生成器',
  alternateName: 'EVA Title Generator',
  url: site.toString(),
  inLanguage: SITE_LOCALES,
  description: dict.pageDescription,
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: dict.chrome.homeCrumb,
      item: canonicalUrl,
    },
  ],
}

const schemas = [websiteSchema, softwareSchema, faqSchema, breadcrumbSchema]
---

<title>{dict.pageTitle}</title>
<meta name="description" content={dict.pageDescription} />
<meta name="keywords" content={dict.pageKeywords} />
<meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />
<meta name="application-name" content="EVA标题生成器" />
<meta name="apple-mobile-web-app-title" content="EVA标题生成器" />
<meta name="theme-color" content="#090909" />
<link rel="canonical" href={canonicalUrl} />
{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hrefLang} href={alternate.href} />)}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="EVA标题生成器" />
<meta property="og:title" content={dict.pageTitle} />
<meta property="og:description" content={dict.pageDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content={meta.ogLocale} />
{SITE_LOCALES.filter((locale) => locale !== dict.locale).map((locale) => (
  <meta property="og:locale:alternate" content={LOCALE_META[locale].ogLocale} />
))}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={dict.pageTitle} />
<meta name="twitter:description" content={dict.pageDescription} />
<meta name="twitter:image" content={imageUrl} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(schemas)}></script>
