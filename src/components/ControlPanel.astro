---
import { formatOptions } from '@/lib/config/formats'
import type { Dictionary } from '@/lib/i18n/types'
const { dict } = Astro.props as { dict: Dictionary }
---
<aside class="dv-command dv-title-controls" aria-label={dict.generator.title}>
  <header class="dv-command__head"><p class="dv-eyebrow">CONTROL ／ TITLE DATA</p><h1>{dict.generator.title}</h1><span>{dict.generator.sections.format}、WebP、PNG、SVG</span></header>
  <label class="dv-field" for="format-select"><span class="dv-field__label">{dict.generator.fields.format}</span><select class="dv-control dv-control--select" id="format-select" data-format-select>{formatOptions.map(f=><option value={f.id}>{dict.generator.formatCopy[f.id].label} · {f.ratio} · {f.width}×{f.height}</option>)}</select></label>
  <label class="dv-field" for="scale-select"><span class="dv-field__label">{dict.generator.fields.exportScale}</span><select class="dv-control dv-control--select" id="scale-select" data-scale-select>
    <option value="1">1×</option>
    <option value="2">2×</option>
  </select></label>
  <label class="dv-field" for="kind-select"><span class="dv-field__label">{dict.generator.fields.exportKind}</span><select class="dv-control dv-control--select" id="kind-select" data-kind-select>
    <option value="webp">WebP</option>
    <option value="png">PNG</option>
  </select></label>
  <label class="dv-field" for="quality-input"><span class="dv-field__label">{dict.generator.fields.exportQuality} <b data-quality-value>80</b></span><input class="dv-range" id="quality-input" type="range" min="1" max="100" value="80" data-quality-input/><span class="dv-hint">{dict.generator.hints.quality}</span></label>
  <p class="dv-hint" data-png-size></p>
  <section class="dv-control-group" aria-label={dict.generator.sections.content}>
    <p class="dv-eyebrow">CONTENT ／ 内容</p>
    <div class="dv-control-pair"><label class="dv-field"><span class="dv-field__label">{dict.generator.fields.series}</span><input class="dv-control" id="field-series" type="text" autocomplete="off" placeholder={dict.generator.placeholders.series}/></label><label class="dv-field"><span class="dv-field__label">{dict.generator.fields.issue}</span><input class="dv-control" id="field-issue" type="text" autocomplete="off" placeholder={dict.generator.placeholders.issue}/></label></div>
    <label class="dv-field"><span class="dv-field__label">{dict.generator.fields.date}</span><input class="dv-control" id="field-date" type="text" autocomplete="off" placeholder={dict.generator.placeholders.date} data-date-input/><span class="dv-hint">{dict.generator.hints.date}</span></label>
    <label class="dv-field"><span class="dv-field__label">{dict.generator.fields.title}</span><input class="dv-control" id="field-title" type="text" autocomplete="off" placeholder={dict.generator.placeholders.title}/></label>
    <label class="dv-field"><span class="dv-field__label">{dict.generator.fields.subtitle}</span><input class="dv-control" id="field-subtitle" type="text" autocomplete="off" placeholder={dict.generator.placeholders.subtitle}/></label>
    <label class="dv-field"><span class="dv-field__label">{dict.generator.fields.mark}</span><input class="dv-control" id="field-mark" type="text" autocomplete="off" placeholder={dict.generator.placeholders.mark}/></label>
  </section>
  <section class="dv-control-group" aria-label={dict.generator.sections.author}><p class="dv-eyebrow">IDENTITY ／ 署名</p><label class="dv-field"><span class="dv-field__label">{dict.generator.fields.author}</span><input class="dv-control" id="field-author" type="text" autocomplete="off" placeholder={dict.generator.placeholders.author}/></label><div class="dv-control-pair"><label class="dv-field"><span class="dv-field__label">{dict.generator.fields.handle}</span><input class="dv-control" id="field-handle" type="text" autocomplete="off" placeholder={dict.generator.placeholders.handle}/></label><label class="dv-field"><span class="dv-field__label">{dict.generator.fields.site}</span><input class="dv-control" id="field-site" type="text" autocomplete="off" placeholder={dict.generator.placeholders.site}/></label></div></section>
  <section class="dv-control-group" aria-label={dict.generator.sections.background}><p class="dv-eyebrow">BACKGROUND ／ 背景</p><label class="dv-field"><span class="dv-field__label">{dict.generator.fields.backgroundFile}</span><input class="dv-control dv-upload" id="background-file" type="file" accept="image/*"/></label><label class="dv-field"><span class="dv-field__label">{dict.generator.fields.backgroundOpacity} <b data-bg-opacity-value>28%</b></span><input class="dv-range" id="background-opacity" type="range" min="0" max="100" value="28"/></label><button type="button" class="dv-action dv-action--quiet" data-clear-background>{dict.generator.buttons.clearBackground}</button></section>
  <footer class="dv-command__actions">
    <p class="dv-state" data-cover-count>{dict.generator.counterUnavailable}</p>
    <div class="dv-action-row"><button type="button" class="dv-action dv-action--primary" data-export-image>{dict.generator.buttons.exportImage}</button><button type="button" class="dv-action" data-export-svg>{dict.generator.buttons.exportSvg}</button></div>
    <div class="dv-state"><strong>SYSTEM</strong><p data-font-status aria-live="polite"></p><p data-fit-status aria-live="polite"></p></div>
    <button type="button" class="dv-action dv-action--quiet" data-reset>{dict.generator.buttons.reset}</button>
  </footer>
</aside>
