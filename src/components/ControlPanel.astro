---
import { formatOptions } from '@/lib/config/formats'
import type { Dictionary } from '@/lib/i18n/types'
const { dict } = Astro.props as { dict: Dictionary }
---
<aside class="dv-command dv-title-controls" aria-label={dict.generator.title}>
  <header class="dv-command__head"><p class="dv-eyebrow">CONTROL ／ TITLE DATA</p><h1>{dict.generator.title}</h1><span>{dict.generator.sections.format}、SVG、PNG</span></header>
  <label class="dv-field" for="format-select"><span class="dv-field__label">{dict.generator.sections.format}</span><select class="dv-control dv-control--select" id="format-select" data-format-select>{formatOptions.map(f=><option value={f.id}>{dict.generator.formatCopy[f.id].label} · {f.ratio} · {f.width}×{f.height}</option>)}</select></label>
  <section class="dv-control-group" aria-label="content">
    <p class="dv-eyebrow">CONTENT ／ 内容</p>
    <div class="dv-control-pair"><label class="dv-field"><span class="dv-field__label">SERIES</span><input class="dv-control" id="field-series" type="text" autocomplete="off" placeholder={dict.generator.fields.series}/></label><label class="dv-field"><span class="dv-field__label">ISSUE</span><input class="dv-control" id="field-issue" type="text" autocomplete="off" placeholder={dict.generator.fields.issue}/></label></div>
    <label class="dv-field"><span class="dv-field__label">DATE</span><input class="dv-control" id="field-date" type="text" autocomplete="off" placeholder={dict.generator.fields.date}/></label>
    <label class="dv-field"><span class="dv-field__label">TITLE</span><textarea class="dv-control dv-control--textarea dv-control--title" id="field-title" rows="3" placeholder={dict.generator.placeholders.title}></textarea></label>
    <label class="dv-field"><span class="dv-field__label">SUBTITLE</span><input class="dv-control" id="field-subtitle" type="text" autocomplete="off" placeholder={dict.generator.placeholders.subtitle}/></label>
  </section>
  <section class="dv-control-group" aria-label="author"><p class="dv-eyebrow">IDENTITY ／ 署名</p><label class="dv-field"><span class="dv-field__label">AUTHOR</span><input class="dv-control" id="field-author" type="text" autocomplete="off" placeholder={dict.generator.fields.author}/></label><div class="dv-control-pair"><label class="dv-field"><span class="dv-field__label">HANDLE</span><input class="dv-control" id="field-handle" type="text" autocomplete="off" placeholder={dict.generator.fields.handle}/></label><label class="dv-field"><span class="dv-field__label">SITE</span><input class="dv-control" id="field-site" type="text" autocomplete="off" placeholder={dict.generator.fields.site}/></label></div></section>
  <section class="dv-control-group" aria-label="background"><p class="dv-eyebrow">BACKGROUND ／ 背景</p><label class="dv-field"><span class="dv-field__label">IMAGE</span><input class="dv-control dv-upload" id="background-file" type="file" accept="image/*"/></label><label class="dv-field"><span class="dv-field__label">{dict.generator.fields.backgroundOpacity} <b data-bg-opacity-value>28%</b></span><input class="dv-range" id="background-opacity" type="range" min="0" max="100" value="28"/></label><button type="button" class="dv-action dv-action--quiet" data-clear-background>{dict.generator.buttons.clearBackground}</button></section>
  <footer class="dv-command__actions"><div class="dv-action-row"><button type="button" class="dv-action dv-action--primary" data-export-png>{dict.generator.buttons.exportPng}</button><button type="button" class="dv-action" data-export-svg>{dict.generator.buttons.exportSvg}</button></div><div class="dv-state"><strong>SYSTEM</strong><p data-font-status aria-live="polite"></p></div><button type="button" class="dv-action dv-action--quiet" data-reset>{dict.generator.buttons.reset}</button></footer>
</aside>
