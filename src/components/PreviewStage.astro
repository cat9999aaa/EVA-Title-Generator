---
import { themeOptions } from '@/lib/config/themes'
import type { Dictionary } from '@/lib/i18n/types'
const { dict } = Astro.props as { dict: Dictionary }
---
<section class="dv-panel dv-title-preview" aria-label={dict.generator.previewLabel}>
  <header class="dv-status-header"><div class="dv-status-header__mark"><i>D</i><span><small>DASHEN TITLE</small><strong>{dict.generator.previewLabel}</strong></span></div><div class="dv-status-header__meta"><b data-dim-bar></b><span class="dv-badge"><i></i>LIVE</span></div></header>
  <div class="dv-title-preview__stage" data-parallax-stage><canvas class="dv-title-grid" data-eva-grid aria-hidden="true"></canvas><div class="dv-title-preview__viewport" data-preview-viewport><div class="dv-title-preview__frame" data-preview-frame><div class="dv-title-preview__svg" data-preview-svg></div></div></div></div>
  <footer class="dv-title-preview__footer"><p>{dict.generator.previewReadyHint}</p><div class="dv-tabs" role="group" aria-label={dict.generator.sections.theme}>{themeOptions.map(theme=><button type="button" data-theme-button data-theme-id={theme.id} aria-pressed="false" aria-label={dict.generator.themeCopy[theme.id].label}><i style={`--swatch-base:${theme.base};--swatch-accent:${theme.accent}`}></i><span>{dict.generator.themeCopy[theme.id].label}</span></button>)}</div></footer>
</section>
