---
import { SITE_LOCALES, pageHref, type SitePage } from '@/lib/i18n/locales'
import type { Dictionary } from '@/lib/i18n/types'

const { dict, page = 'home' } = Astro.props as { dict: Dictionary; page?: SitePage }
---

<nav class="language-switcher" aria-label={dict.nav.languageLabel}>
  {SITE_LOCALES.map((locale) => (
    <a class="language-link" href={pageHref(locale, page)} data-current={String(locale === dict.locale)} hreflang={locale}>
      {dict.nav.languages[locale]}
    </a>
  ))}
</nav>
