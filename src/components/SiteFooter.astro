---
import type { Dictionary } from '@/lib/i18n/types'
const { dict } = Astro.props as { dict: Dictionary }
const isChinese = dict.locale === 'zh-CN'
const prefix = isChinese ? '' : '/en'
---
<footer class="dv-site-footer">
  <div class="dv-site-footer-intro"><a class="dv-footer-brand" href="https://dashen.wang/">大神网</a><p>{isChinese ? '研究。判断。构建。' : 'Research. Judgement. Build.'}</p></div>
  <div class="dv-site-footer-groups">
    <section><h2>{isChinese ? '标题系统' : 'TITLE SYSTEM'}</h2><nav aria-label="title system"><a href={isChinese ? '/' : '/en'}>{dict.nav.generator}</a><a href={`${prefix}/about`}>{dict.nav.about}</a><a href={`${prefix}/faq`}>{dict.nav.faq}</a></nav></section>
    <section><h2>{isChinese ? '输出' : 'OUTPUT'}</h2><nav aria-label="output"><a href={isChinese ? '/' : '/en'}>SVG</a><a href={isChinese ? '/' : '/en'}>PNG</a><a href={isChinese ? '/' : '/en'}>{isChinese ? 'X长文／公众号' : 'X Article / WeChat'}</a></nav></section>
    <section><h2>{isChinese ? '大神网' : 'DASHEN'}</h2><nav aria-label="dashen"><a href="https://dashen.wang/content">{isChinese ? '内容' : 'Content'}</a><a href="https://dashen.wang/tools">{isChinese ? '工具' : 'Tools'}</a><a href="https://dashen.wang/business">{isChinese ? '商务合作' : 'Business'}</a></nav></section>
    <section><h2>{isChinese ? '来源' : 'SOURCE'}</h2><nav aria-label="source"><a href="https://github.com/cat9999aaa/EVA-Title-Generator">GitHub</a><a href={dict.credit.upstreamUrl} target="_blank" rel="noreferrer">{isChinese ? '字体项目' : 'Font project'}</a></nav></section>
  </div>
  <div class="dv-footer-license"><p>{dict.footer.note}</p><p>{dict.footer.credit}</p></div>
</footer>
