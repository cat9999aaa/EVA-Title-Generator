---
import { pageHref } from '@/lib/i18n/locales'
import type { Dictionary } from '@/lib/i18n/types'
const { dict } = Astro.props as { dict: Dictionary }
const home = pageHref(dict.locale, 'home')
---
<footer class="dv-site-footer">
  <div class="dv-site-footer-intro"><a class="dv-footer-brand" href="https://dashen.wang/">大神网</a><p>{dict.chrome.tagline}</p></div>
  <div class="dv-site-footer-groups">
    <section><h2>{dict.chrome.groupTitle}</h2><nav aria-label="title system"><a href={home}>{dict.nav.generator}</a><a href={pageHref(dict.locale, 'about')}>{dict.nav.about}</a><a href={pageHref(dict.locale, 'faq')}>{dict.nav.faq}</a><a href={pageHref(dict.locale, 'apiDocs')}>{dict.nav.apiDocs}</a></nav></section>
    <section><h2>{dict.chrome.groupOutput}</h2><nav aria-label="output"><a href={home}>{dict.chrome.outputRaster}</a><a href={home}>{dict.chrome.outputSvg}</a><a href={home}>{dict.chrome.outputSizes}</a></nav></section>
    <section><h2>{dict.chrome.groupDashen}</h2><nav aria-label="dashen"><a href="https://dashen.wang/content">{dict.chrome.content}</a><a href="https://dashen.wang/tools">{dict.chrome.tools}</a><a href="https://dashen.wang/business">{dict.chrome.business}</a></nav></section>
    <section><h2>{dict.chrome.groupSource}</h2><nav aria-label="source"><a href="https://github.com/cat9999aaa/EVA-Title-Generator">GitHub</a><a href={dict.credit.upstreamUrl} target="_blank" rel="noreferrer">{dict.chrome.fontProject}</a></nav></section>
  </div>
  <div class="dv-footer-license"><p>{dict.footer.note}</p><p>{dict.footer.credit}</p></div>
</footer>
