---
import ApiDocs from '@/components/ApiDocs.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getDictionary, withPage } from '@/lib/i18n'

const dict = withPage(getDictionary('zh-CN'), 'apiDocs')
---

<BaseLayout dict={dict} page="apiDocs">
  <div class="site-main">
    <ApiDocs dict={dict} />
  </div>
</BaseLayout>
